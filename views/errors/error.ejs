<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= status %> - <%= heading %> - SecureNews</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<main class="error-page">
  <p class="error-code"><%= status %></p>
  <h1><%= heading %></h1>
  <% if (message) { %><p><%= message %></p><% } %>
  <p class="hint"><%= hint %></p>
  <% if (requestId) { %><p class="hint">Mã tham chiếu: <code><%= requestId %></code></p><% } %>
  <p><a href="/">Về trang chủ</a></p>
</main>
</body>
</html>