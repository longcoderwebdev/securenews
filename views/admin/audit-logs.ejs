<%- include('../partials/header') %>
<h1>Nhật ký hoạt động</h1>

<form method="get" action="/admin/audit-logs" class="filters">
  <div>
    <label for="action">Hành động</label>
    <select id="action" name="action">
      <option value="">Tất cả</option>
      <% actions.forEach((a) => { %>
        <option value="<%= a %>" <%= a === filters.action ? 'selected' : '' %>><%= a %></option>
      <% }) %>
    </select>
  </div>
  <div>
    <label for="email">Người dùng (email)</label>
    <input id="email" name="email" type="text" value="<%= filters.email %>" maxlength="120">
  </div>
  <div>
    <label for="result">Kết quả</label>
    <select id="result" name="result">
      <option value="">Tất cả</option>
      <option value="success" <%= filters.result === 'success' ? 'selected' : '' %>>Thành công</option>
      <option value="failure" <%= filters.result === 'failure' ? 'selected' : '' %>>Thất bại</option>
    </select>
  </div>
  <div>
    <label for="from">Từ ngày</label>
    <input id="from" name="from" type="date" value="<%= filters.from %>">
  </div>
  <div>
    <label for="to">Đến ngày</label>
    <input id="to" name="to" type="date" value="<%= filters.to %>">
  </div>
  <div>
    <button type="submit">Lọc</button>
    <a href="/admin/audit-logs">Xóa lọc</a>
  </div>
</form>

<p class="hint">Tổng cộng <%= paging.total %> dòng. Nhật ký chỉ cho phép xem, không sửa hay xóa.</p>

<% if (items.length === 0) { %>
  <p>Không có dòng nhật ký phù hợp.</p>
<% } else { %>
  <table>
    <thead>
      <tr><th>Thời gian</th><th>Người dùng</th><th>Hành động</th><th>Đối tượng</th><th>IP</th><th>Kết quả</th><th>Chi tiết</th></tr>
    </thead>
    <tbody>
      <% items.forEach((l) => { %>
        <tr class="log-row">
          <td><%= new Date(l.createdAt).toLocaleString('vi-VN') %></td>
          <td><%= l.user ? l.user.email : '(khách)' %></td>
          <td><%= l.action %></td>
          <td><%= l.target || '' %></td>
          <td><%= l.ip || '' %></td>
          <td><span class="badge <%= l.result === 'success' ? 'badge-published' : 'badge-rejected' %>"><%= l.result === 'success' ? 'Thành công' : 'Thất bại' %></span></td>
          <td><%= l.detail || '' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <% if (paging.totalPages > 1) { %>
    <div class="pager">
      <% if (paging.page > 1) { %><a href="<%= buildUrl(paging.page - 1) %>">Trước</a><% } %>
      <span>Trang <%= paging.page %> / <%= paging.totalPages %></span>
      <% if (paging.page < paging.totalPages) { %><a href="<%= buildUrl(paging.page + 1) %>">Sau</a><% } %>
    </div>
  <% } %>
<% } %>
<p><a href="/admin">Về bảng điều khiển</a></p>
<%- include('../partials/footer') %>